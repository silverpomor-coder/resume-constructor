\pard\intbl\itap1\sl260{\fs18 \uc0\u1054 \uc0\u1090 \uc0\u1074 \uc0\u1077 \uc0\u1090 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1077 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1081 , \uc0\u1091 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1072 \uc0\u1090 \uc0\u1100  \uc0\u1074  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1072 \uc0\u1085 \uc0\u1076 \uc0\u1077 , \uc0\u1073 \uc0\u1077 \uc0\u1079  \uc0\u1074 \uc0\u1088 \uc0\u1077 \uc0\u1076 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1087 \uc0\u1088 \uc0\u1080 \uc0\u1074 \uc0\u1099 \uc0\u1095 \uc0\u1077 \uc0\u1082 , \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1085 \uc0\u1099 \uc0\u1081 , \uc0\u1080 \uc0\u1089 \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1085 \uc0\u1080 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1099 \uc0\u1081 , \uc0\u1087 \uc0\u1089 \uc0\u1080 \uc0\u1093 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1081  \uc0\u1091 \uc0\u1089 \uc0\u1090 \uc0\u1086 \uc0\u1081 \uc0\u1095 \uc0\u1080 \uc0\u1074 , \uc0\u1089 \uc0\u1086 \uc0\u1073 \uc0\u1083 \uc0\u1102 \uc0\u1076 \uc0\u1072 \uc0\u1102  \uc0\u1082 \uc0\u1086 \uc0\u1085 \uc0\u1092 \uc0\u1080 \uc0\u1076 \uc0\u1077 \uc0\u1085 \uc0\u1094 \uc0\u1080 \uc0\u1072 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1100  \uc0\u1080  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1084 \uc0\u1077 \uc0\u1088 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1082 \uc0\u1091 \uc0\u1102  \uc0\u1090 \uc0\u1072 \uc0\u1081 \uc0\u1085 \uc0\u1091  \uc0\u1087 \uc0\u1088 \uc0\u1077 \uc0\u1076 \uc0\u1087 \uc0\u1088 \uc0\u1080 \uc0\u1103 \uc0\u1090 \uc0\u1080 \uc0\u1103 , \uc0\u1080 \uc0\u1089 \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1085 \uc0\u1080 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1099 \uc0\u1081 . \uc0\u1057 \uc0\u1091 \uc0\u1076 \uc0\u1080 \uc0\u1084 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1080  \uc0\u1085 \uc0\u1077 \uc0\u1090 . \uc0\u1056 \uc0\u1072 \uc0\u1079 \uc0\u1088 \uc0\u1077 \uc0\u1096 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1080  \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1095 \uc0\u1080 \uc0\u1077  \uc0\u1086 \uc0\u1075 \uc0\u1085 \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1077 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1086 \uc0\u1075 \uc0\u1086  \uc0\u1086 \uc0\u1088 \uc0\u1091 \uc0\u1078 \uc0\u1080 \uc0\u1103  \uc0\u1086 \uc0\u1075 \uc0\u1088 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1085 \uc0\u1085 \uc0\u1086 \uc0\u1075 \uc0\u1086  \uc0\u1087 \uc0\u1086 \uc0\u1088 \uc0\u1072 \uc0\u1078 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077 .}\cell\row

\trowd\cellx9638\pard\intbl\itap1\sa150\sb500\brdrb\brdrs\brdrcf2{\fs22\cf1 \uc0\u1050 \uc0\u1086 \uc0\u1084 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1072 \uc0\u1088 \uc0\u1080 \uc0\u1080  \uc0\u1082  \uc0\u1088 \uc0\u1077 \uc0\u1079 \uc0\u1102 \uc0\u1084 \uc0\u1077 }\cell\row

\trowd\cellx1800\cellx9638\pard\intbl\itap1\sl220{\fs16\cf3 9 \uc0\u1080 \uc0\u1102 \uc0\u1085 \uc0\u1103  2026}\cell
\pard\intbl\itap1\sl260{\fs18 \uc0\u1085 \uc0\u1077  \uc0\u1087 \uc0\u1086 \uc0\u1085 \uc0\u1103 \uc0\u1090 \uc0\u1085 \uc0\u1086 , \uc0\u1082 \uc0\u1072 \uc0\u1082  \uc0\u1086 \uc0\u1085  \uc0\u1080 \uc0\u1079  \uc0\u1082 \uc0\u1072 \uc0\u1083 \uc0\u1091 \uc0\u1075 \uc0\u1080  \uc0\u1089 \uc0\u1086 \uc0\u1073 \uc0\u1088 \uc0\u1072 \uc0\u1083 \uc0\u1089 \uc0\u1103  \uc0\u1087 \uc0\u1086  2.5 \uc0\u1095 \uc0\u1072 \uc0\u1089 \uc0\u1072  \uc0\u1074  \uc0\u1086 \uc0\u1076 \uc0\u1085 \uc0\u1091  \uc0\u1089 \uc0\u1090 \uc0\u1086 \uc0\u1088 \uc0\u1086 \uc0\u1085 \uc0\u1091  \uc0\u1077 \uc0\u1093 \uc0\u1072 \uc0\u1090 \uc0\u1100  \uc0\u1074  \uc0\u1082 \uc0\u1088 \uc0\u1072 \uc0\u1089 \uc0\u1085 \uc0\u1091 \uc0\u1102  \uc0\u1087 \uc0\u1072 \uc0\u1093 \uc0\u1088 \uc0\u1091 ? \uc0\u1076 \uc0\u1086  2022 \uc0\u1075 \uc0\u1086 \uc0\u1076 \uc0\u1072  \uc0\u1074 \uc0\u1086 \uc0\u1086 \uc0\u1073 \uc0\u1097 \uc0\u1077  \uc0\u1086 \uc0\u1093 \uc0\u1088 \uc0\u1072 \uc0\u1085 \uc0\u1085 \uc0\u1080 \uc0\u1082 \uc0\u1086 \uc0\u1084 (\uc0\u1053 \uc0\u1045  \uc0\u1083 \uc0\u1080 \uc0\u1095 \uc0\u1082 \uc0\u1072 ) \uc0\u1090 \uc0\u1088 \uc0\u1091 \uc0\u1076 \uc0\u1080 \uc0\u1083 \uc0\u1089 \uc0\u1103 . \uc0\u1055 \uc0\u1086 \uc0\u1090 \uc0\u1086 \uc0\u1084  \uc0\u1074 \uc0\u1080 \uc0\u1076 \uc0\u1085 \uc0\u1086  \uc0\u1074  \uc0\u1089 \uc0\u1077 \uc0\u1073 \uc0\u1103  \uc0\u1087 \uc0\u1086 \uc0\u1074 \uc0\u1077 \uc0\u1088 \uc0\u1080 \uc0\u1083 .}\par\pard\intbl\itap1{\fs18\cf1 \uc0\u1040 \uc0\u1083 \uc0\u1077 \uc0\u1082 \uc0\u1089 \uc0\u1072 \uc0\u1085 \uc0\u1076 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072  \uc0\u1053 \uc0\u1072 \uc0\u1090 \uc0\u1072 \uc0\u1083 \uc0\u1100 \uc0\u1103  \uc0\u1042 \uc0\u1080 \uc0\u1082 \uc0\u1090 \uc0\u1086 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1085 \uc0\u1072 }
\cell\row

\trowd\cellx9638\pard\intbl\itap1\sa150\sb500\brdrb\brdrs\brdrcf2{\fs22\cf1 \uc0\u1048 \uc0\u1089 \uc0\u1090 \uc0\u1086 \uc0\u1088 \uc0\u1080 \uc0\u1103  \uc0\u1086 \uc0\u1073 \uc0\u1097 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1089  \uc0\u1082 \uc0\u1072 \uc0\u1085 \uc0\u1076 \uc0\u1080 \uc0\u1076 \uc0\u1072 \uc0\u1090 \uc0\u1086 \uc0\u1084 }\cell\row


\trowd\cellx1800\cellx9638\pard\intbl\itap1\sl220{\fs16\cf3 \uc0\u1054 \uc0\u1090 \uc0\u1082 \uc0\u1083 \uc0\u1080 \uc0\u1082 \uc0\u1085 \uc0\u1091 \uc0\u1083 \uc0\u1089 \uc0\u1103 }\cell
\pard\intbl\itap1\sl260{\fs18 \uc0\u1059 \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1083 \uc0\u1103 \uc0\u1102 \uc0\u1097 \uc0\u1080 \uc0\u1081  \uc0\u1079 \uc0\u1072 \uc0\u1075 \uc0\u1086 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1085 \uc0\u1099 \uc0\u1084  \uc0\u1076 \uc0\u1086 \uc0\u1084 \uc0\u1086 \uc0\u1084 }\par{\fs18\cf1 15 \uc0\u1080 \uc0\u1102 \uc0\u1085 \uc0\u1103  2026}

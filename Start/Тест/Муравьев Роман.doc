\pard\intbl\itap1\sl260{\fs18 \uc0\u1052 \uc0\u1091 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1100 \uc0\u1077 \uc0\u1074  \uc0\u1056 \uc0\u1086 \uc0\u1084 \uc0\u1072 \uc0\u1085  , \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1100  \uc0\u1074  \uc0\u1082 \uc0\u1089 \uc0\u1090 \uc0\u1072 \uc0\u1092 }\par\pard\intbl\itap1{\fs18\cf1 \uc0\u1040 \uc0\u1083 \uc0\u1077 \uc0\u1082 \uc0\u1089 \uc0\u1072 \uc0\u1085 \uc0\u1076 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072  \uc0\u1053 \uc0\u1072 \uc0\u1090 \uc0\u1072 \uc0\u1083 \uc0\u1100 \uc0\u1103  \uc0\u1042 \uc0\u1080 \uc0\u1082 \uc0\u1090 \uc0\u1086 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1085 \uc0\u1072 }
\cell\row

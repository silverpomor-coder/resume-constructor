\trowd\cellx1800\cellx9638\pard\intbl\itap1\sl220{\fs16\cf3 2019}\cell
\pard\intbl\itap1\sl280{\fs24\b \uc0\u1054 \uc0\u1054 \uc0\u1054 "\uc0\u1058 \uc0\u1080 \uc0\u1088 -\uc0\u1057 \uc0\u1087 \uc0\u1086 \uc0\u1088 \uc0\u1090 \uc0\u1080 \uc0\u1085 \uc0\u1075 "}\par
\pard\intbl\itap1\sl260{\fs18 \uc0\u1054 \uc0\u1054 \uc0\u1054 "\uc0\u1058 \uc0\u1080 \uc0\u1088 -\uc0\u1057 \uc0\u1087 \uc0\u1086 \uc0\u1088 \uc0\u1090 \uc0\u1080 \uc0\u1085 \uc0\u1075 ", \uc0\u1055 \uc0\u1088 \uc0\u1086 \uc0\u1092 \uc0\u1077 \uc0\u1089 \uc0\u1089 \uc0\u1080 \uc0\u1086 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1072 \uc0\u1103  \uc0\u1087 \uc0\u1086 \uc0\u1076 \uc0\u1075 \uc0\u1086 \uc0\u1090 \uc0\u1086 \uc0\u1074 \uc0\u1082 \uc0\u1072  \uc0\u1095 \uc0\u1072 \uc0\u1089 \uc0\u1090 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1086 \uc0\u1093 \uc0\u1088 \uc0\u1072 \uc0\u1085 \uc0\u1085 \uc0\u1080 \uc0\u1082 \uc0\u1086 \uc0\u1074  6 \uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1088 \uc0\u1103 \uc0\u1076 \uc0\u1072 }
\cell\row\trowd\cellx1800\cellx9638\pard\intbl\itap1\sl220{\fs16\cf3 2014}\cell
\pard\intbl\itap1\sl280{\fs24\b \uc0\u1062 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1088  \uc0\u1082 \uc0\u1086 \uc0\u1085 \uc0\u1090 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1072 \uc0\u1088 \uc0\u1080 \uc0\u1081 \uc0\u1085 \uc0\u1086 \uc0\u1081  \uc0\u1087 \uc0\u1086 \uc0\u1076 \uc0\u1075 \uc0\u1086 \uc0\u1090 \uc0\u1086 \uc0\u1074 \uc0\u1082 \uc0\u1080  \uc0\u1074 \uc0\u1086 \uc0\u1076 \uc0\u1080 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1077 \uc0\u1081  "\uc0\u1052 \uc0\u1072 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1088 \uc0\u1050 \uc0\u1083 \uc0\u1072 \uc0\u1089 \uc0\u1089 "}\par
\pard\intbl\itap1\sl260{\fs18 \uc0\u1062 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1088  \uc0\u1082 \uc0\u1086 \uc0\u1085 \uc0\u1090 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1072 \uc0\u1088 \uc0\u1080 \uc0\u1081 \uc0\u1085 \uc0\u1086 \uc0\u1081  \uc0\u1087 \uc0\u1086 \uc0\u1076 \uc0\u1075 \uc0\u1086 \uc0\u1090 \uc0\u1086 \uc0\u1074 \uc0\u1082 \uc0\u1080  \uc0\u1074 \uc0\u1086 \uc0\u1076 \uc0\u1080 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1077 \uc0\u1081  "\uc0\u1052 \uc0\u1072 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1088 \uc0\u1050 \uc0\u1083 \uc0\u1072 \uc0\u1089 \uc0\u1089 ", \uc0\u1050 \uc0\u1086 \uc0\u1085 \uc0\u1090 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1072 \uc0\u1088 \uc0\u1080 \uc0\u1081 \uc0\u1085 \uc0\u1072 \uc0\u1103  \uc0\u1087 \uc0\u1086 \uc0\u1076 \uc0\u1075 \uc0\u1086 \uc0\u1090 \uc0\u1086 \uc0\u1074 \uc0\u1082 \uc0\u1072  \uc0\u1074 \uc0\u1086 \uc0\u1076 \uc0\u1080 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1077 \uc0\u1081  VIP-\uc0\u1082 \uc0\u1086 \uc0\u1088 \uc0\u1090 \uc0\u1077 \uc0\u1078 \uc0\u1072 }
\cell\row\trowd\cellx1800\cellx9638\pard\intbl\itap1\sl220{\fs16\cf3 2012}\cell
\pard\intbl\itap1\sl280{\fs24\b \uc0\u1062 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1088  \uc0\u1042 \uc0\u1086 \uc0\u1076 \uc0\u1080 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1100 \uc0\u1089 \uc0\u1082 \uc0\u1086 \uc0\u1075 \uc0\u1086  \uc0\u1052 \uc0\u1072 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1088 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1072  "\uc0\u1041 \uc0\u1077 \uc0\u1079 \uc0\u1086 \uc0\u1087 \uc0\u1072 \uc0\u1089 \uc0\u1085 \uc0\u1072 \uc0\u1103  \uc0\u1076 \uc0\u1086 \uc0\u1088 \uc0\u1086 \uc0\u1075 \uc0\u1072 "}\par
\pard\intbl\itap1\sl260{\fs18 \uc0\u1062 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1088  \uc0\u1042 \uc0\u1086 \uc0\u1076 \uc0\u1080 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1100 \uc0\u1089 \uc0\u1082 \uc0\u1086 \uc0\u1075 \uc0\u1086  \uc0\u1052 \uc0\u1072 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1088 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1072  "\uc0\u1041 \uc0\u1077 \uc0\u1079 \uc0\u1086 \uc0\u1087 \uc0\u1072 \uc0\u1089 \uc0\u1085 \uc0\u1072 \uc0\u1103  \uc0\u1076 \uc0\u1086 \uc0\u1088 \uc0\u1086 \uc0\u1075 \uc0\u1072 ", \uc0\u1050 \uc0\u1086 \uc0\u1085 \uc0\u1090 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1072 \uc0\u1088 \uc0\u1080 \uc0\u1081 \uc0\u1085 \uc0\u1072 \uc0\u1103  \uc0\u1087 \uc0\u1086 \uc0\u1076 \uc0\u1075 \uc0\u1086 \uc0\u1090 \uc0\u1086 \uc0\u1074 \uc0\u1082 \uc0\u1072 }
